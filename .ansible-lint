---
# profile: basic
# profile: null

# Make ansible-lint resolve paths relative to playbooks/ansible.cfg
project_dir: playbooks/

# enable_list:
#   # - yaml
#   - fqcn

exclude_paths:
  - .git
  - .ansible
  - tests/.ansible
  - collections/ansible_collections/mikeeq/apps_server/roles/home_assistant/files/config
  - "**/molecule/"
  - playbooks/requirements.yaml

skip_list:
  - name
  - var-naming
  - risky-file-permissions
  - role-name[path]
  - no-changed-when
  - risky-shell-pipe
  - command-instead-of-shell
  - command-instead-of-module
  - no-handler
  - latest
  - literal-compare
  - package-latest
  - ignore-errors
  - galaxy[no-changelog]
  # - yaml[line-length]
#   - tags:formatting,yaml


# To skip task from verifying
# add comment # noqa: command-instead-of-module
## or
# tags:
#     - skip_ansible_lint
