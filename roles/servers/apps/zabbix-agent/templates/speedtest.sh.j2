#!/bin/bash
# Zabbix speedtest monitoring script
# Runs speedtest-cli and caches results to avoid running it too frequently
# Cache duration: 30 minutes (1800 seconds)

# Suppress all stderr - Zabbix agent captures it as part of the value
exec 2>/dev/null

CACHE_DIR="/var/lib/zabbix"
CACHE_FILE="${CACHE_DIR}/speedtest_result.json"
LOCK_FILE="${CACHE_DIR}/speedtest.lock"
CACHE_MAX_AGE=1800
METRIC="${1:-all}"

# Ensure cache directory exists
mkdir -p "${CACHE_DIR}" 2>/dev/null

run_speedtest() {
    # Prevent concurrent runs
    if [ -f "${LOCK_FILE}" ]; then
        LOCK_AGE=$(( $(date +%s) - $(stat -c %Y "${LOCK_FILE}") ))
        # Stale lock (older than 120s)
        if [ "${LOCK_AGE}" -ge 120 ]; then
            rm -f "${LOCK_FILE}"
        else
            return 1
        fi
    fi

    touch "${LOCK_FILE}"
    HOME="${CACHE_DIR}" speedtest-cli --json --secure > "${CACHE_FILE}.tmp" 2>/dev/null
    local rc=$?
    rm -f "${LOCK_FILE}"

    if [ ${rc} -eq 0 ] && [ -s "${CACHE_FILE}.tmp" ]; then
        mv "${CACHE_FILE}.tmp" "${CACHE_FILE}"
        chmod 644 "${CACHE_FILE}"
    else
        rm -f "${CACHE_FILE}.tmp"
        return 1
    fi
}

# Check if cache exists and is fresh enough
if [ -f "${CACHE_FILE}" ]; then
    CACHE_AGE=$(( $(date +%s) - $(stat -c %Y "${CACHE_FILE}") ))
    if [ "${CACHE_AGE}" -ge "${CACHE_MAX_AGE}" ]; then
        run_speedtest
    fi
else
    run_speedtest
fi

if [ ! -f "${CACHE_FILE}" ]; then
    echo "0"
    exit 0
fi

case "${METRIC}" in
    download)
        python3 -c "import json; d=json.load(open('${CACHE_FILE}')); print(d['download'])" 2>/dev/null || echo 0
        ;;
    upload)
        python3 -c "import json; d=json.load(open('${CACHE_FILE}')); print(d['upload'])" 2>/dev/null || echo 0
        ;;
    ping)
        python3 -c "import json; d=json.load(open('${CACHE_FILE}')); print(d['ping'])" 2>/dev/null || echo 0
        ;;
    server_name)
        python3 -c "import json; d=json.load(open('${CACHE_FILE}')); print(d['server']['sponsor'] + ' - ' + d['server']['name'])" 2>/dev/null || echo "N/A"
        ;;
    all)
        cat "${CACHE_FILE}"
        ;;
    *)
        echo "Usage: $0 {download|upload|ping|server_name|all}"
        exit 1
        ;;
esac
