FROM ubuntu:26.04

# ENV container docker
ENV UBUNTU_USERNAME=mikee
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y \
      curl \
      git \
      sudo \
    && apt-get clean all

RUN useradd -m ${UBUNTU_USERNAME} && usermod -aG sudo ${UBUNTU_USERNAME} \
    && echo "${UBUNTU_USERNAME} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Install mise as user
USER ${UBUNTU_USERNAME}
ENV MISE_YES=1
RUN curl https://mise.run | sh

# Install tools via mise
#COPY --chown=${UBUNTU_USERNAME} mise.toml /home/${UBUNTU_USERNAME}/.config/mise/config.toml
#RUN ~/.local/bin/mise install && ~/.local/bin/mise reshim
ENV PATH="/home/${UBUNTU_USERNAME}/.local/share/mise/shims:/home/${UBUNTU_USERNAME}/.local/bin:${PATH}"

USER root

CMD ["/usr/bin/sleep", "infinity"]
