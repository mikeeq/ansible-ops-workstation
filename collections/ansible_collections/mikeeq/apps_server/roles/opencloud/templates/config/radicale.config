# Based on config/radicale/config from opencloud-compose (stable-7.2),
# only non-default values are set. Reference: https://radicale.org/v3.html
[server]
hosts = 0.0.0.0:5232

[auth]
# OpenCloud authenticates the user and passes it in X-Remote-User
type = http_x_remote_user

[storage]
predefined_collections = {
    "def-addressbook": {
       "D:displayname": "Personal Address Book",
       "tag": "VADDRESSBOOK"
    },
    "def-calendar": {
       "C:supported-calendar-component-set": "VEVENT,VJOURNAL,VTODO",
       "D:displayname": "Personal Calendar",
       "tag": "VCALENDAR"
    }
  }

[web]
type = none
{% if opencloud_radicale_sharing | bool %}

# Sharing of collections between users (Radicale >= 3.7), see
# https://github.com/Kozea/Radicale/blob/master/SHARING.md
[sharing]
type = csv
collection_by_map = True
collection_by_token = True
permit_create_map = True
permit_create_token = True
{% endif %}
