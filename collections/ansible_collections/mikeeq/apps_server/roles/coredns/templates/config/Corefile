. {
    log
    errors
    reload 10s
    forward . 1.1.1.1:53
    # If you wish to use a standard ZONE File format, uncomment the following line and customize the specified file
    file /etc/coredns/{{ coredns_zone_filename }} {{ coredns_domain_name }}

    # If you wish to use a standard Hosts File format, uncomment the following line and customize the specified file
    # hosts /etc/coredns/example.com.hosts example.com
    prometheus localhost:9153
}

{% if coredns_public_port | string | length > 0 %}
# Internet-facing listener (port forwarded by the router): authoritative answers
# for {{ coredns_domain_name }} only, no recursion, so it cannot be abused as an
# open resolver (DNS amplification). Other zones get REFUSED.
{{ coredns_domain_name }}:{{ coredns_public_port }} {
    log
    errors
    file /etc/coredns/{{ coredns_zone_filename }} {{ coredns_domain_name }}
}

{% endif %}
