      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"isp-monitor\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"speedtest\")\n  |> filter(fn: (r) => r._field == \"download_mbps\" or r._field == \"upload_mbps\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])",
          "refId": "A"
