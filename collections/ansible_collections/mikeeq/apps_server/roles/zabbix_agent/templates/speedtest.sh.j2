#!/bin/bash
# Zabbix speedtest monitoring script
# Read-only: cache is populated by a cron job running as root
# This script only reads the cache and extracts the requested metric

exec 2>/dev/null

CACHE_FILE="/etc/zabbix/scripts/speedtest_result.json"
METRIC="${1:-all}"

if [ ! -f "${CACHE_FILE}" ] || [ ! -s "${CACHE_FILE}" ]; then
    echo "0"
    exit 0
fi

case "${METRIC}" in
    download) result=$(jq -r '.download // 0' "${CACHE_FILE}"); echo "${result:-0}" ;;
    upload) result=$(jq -r '.upload // 0' "${CACHE_FILE}"); echo "${result:-0}" ;;
    ping) result=$(jq -r '.ping // 0' "${CACHE_FILE}"); echo "${result:-0}" ;;
    server_name) result=$(jq -r '(.server.sponsor // "N/A") + " - " + (.server.name // "N/A")' "${CACHE_FILE}"); echo "${result:-N/A}" ;;
    all) cat "${CACHE_FILE}" ;;
    *) echo "0" ;;
esac
