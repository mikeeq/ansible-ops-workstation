#cloud-config
# vim: syntax=yaml
---
chpasswd:
  expire: false
ssh_pwauth: true
output:
  all: '| tee -a /var/log/cloud-init-output.log'
users:
  - name: root
    lock-passwd: true
  - name: {{ libvirt_default_admin_username }}
    passwd: {{ libvirt_default_admin_password | password_hash('sha512') }}
    lock-passwd: false
    groups:
      - wheel
